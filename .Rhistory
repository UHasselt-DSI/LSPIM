for (ii in split(seq_len(N), group)) {
ng <- length(ii)
if (ng < 3L) stop("Need at least three subjects per group.")
# Centered, group-specific jackknife pseudo-values divided by ng.
# D_i = -(ng-1)/ng * (beta_(-i) - mean_g beta_(-i)).
D[ii, ] <- -(ng - 1) / ng * sweep(
deleted[ii, , drop = FALSE], 2L,
colMeans(deleted[ii, , drop = FALSE]), "-")
factors[ii] <- ng / (ng - 1)
}
V <- crossprod(D * sqrt(factors))
list(beta = beta, D = D, V = V, deleted = deleted,
group = group, factors = factors)
}
.rihc_chol <- function(V) {
V <- (V + t(V)) / 2
ev <- eigen(V, symmetric = TRUE, only.values = TRUE)$values
if (any(!is.finite(ev)) || min(ev) <= 1e-10 * max(abs(ev)))
stop("Contrast covariance is singular or ill-conditioned; no PSD repair applied.")
chol(V)
}
.rihc_weights <- function(n, weights) {
if (weights == "rademacher") return(sample(c(-1, 1), n, replace = TRUE))
a <- (1 - sqrt(5)) / 2
z <- (1 + sqrt(5)) / 2
pa <- (sqrt(5) + 1) / (2 * sqrt(5))
ifelse(runif(n) < pa, a, z)
}
.rihc_test <- function(jk, L, Xi, hypothesis, alpha) {
# L may contain redundant rows. Use independent rows for the Wald statistic,
# and all supplied rows for max-|t|, marginal p-values, and Holm.
qrL <- qr(t(L), tol = 1e-10)
q <- qrL$rank
if (q < 1L) stop("Empty contrast hypothesis.")
L0 <- L[qrL$pivot[seq_len(q)], , drop = FALSE]
H <- jk$D %*% t(L)
H0 <- jk$D %*% t(L0)
theta <- drop(L %*% jk$beta)
theta0 <- drop(L0 %*% jk$beta)
factors <- jk$factors
se <- sqrt(colSums(H^2 * factors))
if (any(!is.finite(se)) || any(se <= 0)) stop("Invalid contrast standard error.")
ch <- .rihc_chol(crossprod(H0 * sqrt(factors)))
Q <- sum(forwardsolve(t(ch), theta0)^2)
T <- theta / se
M <- max(abs(T))
B <- ncol(Xi)
Qstar <- Mstar <- numeric(B)
Tstar <- matrix(NA_real_, B, nrow(L))
invalid <- 0L
for (b in seq_len(B)) {
ans <- tryCatch({
# Perturb centered pseudo-values, then refit their group means.
# Recenter residuals WITHIN ARM for each draw's covariance.
Hb <- H * Xi[, b]
delta <- colSums(Hb)
for (ii in split(seq_len(nrow(Hb)), jk$group)) {
Hb[ii, ] <- sweep(Hb[ii, , drop = FALSE], 2L,
colMeans(Hb[ii, , drop = FALSE]), "-")
}
seb <- sqrt(colSums(Hb^2 * factors))
if (any(!is.finite(seb)) || any(seb <= 0)) stop("Invalid bootstrap SE.")
# H0 consists of the selected independent contrast columns of H.
selected <- qrL$pivot[seq_len(q)]
chb <- .rihc_chol(crossprod(Hb[, selected, drop = FALSE] * sqrt(factors)))
list(Q = sum(forwardsolve(t(chb), delta[selected])^2), T = delta / seb)
}, error = function(e) NULL)
if (is.null(ans)) {
invalid <- invalid + 1L
} else {
Qstar[b] <- ans$Q
Tstar[b, ] <- ans$T
Mstar[b] <- max(abs(ans$T))
}
}
# Do not silently condition on successful bootstrap draws.
if (invalid > 0L)
stop(invalid, " of ", B, " bootstrap draws had invalid covariance; test marked failed.")
tailp <- function(z, t) (1 + sum(z >= t)) / (B + 1)
p_raw <- vapply(seq_along(T), function(j) tailp(abs(Tstar[, j]), abs(T[j])), 0.0)
p_holm <- p.adjust(p_raw, method = "holm")
p_single <- vapply(abs(T), function(t) tailp(Mstar, t), 0.0)
p <- c(tailp(Qstar, Q), tailp(Mstar, M), min(p_holm))
rows <- data.frame(hypothesis = hypothesis,
procedure = c("Jackknife_wild_Wald", "Jackknife_wild_max", "Jackknife_wild_Holm"),
statistic = c(Q, M, M), df = q, p_value = p, reject = p <= alpha,
p_chisq = c(pchisq(Q, q, lower.tail = FALSE), NA_real_, NA_real_),
bootstrap_q95 = c(unname(quantile(Qstar, .95)), unname(quantile(Mstar, .95)), NA_real_),
n_invalid_bootstrap = 0L, status = "ok", error = NA_character_)
contrasts <- data.frame(contrast = rownames(L), estimate = theta, SE = se,
statistic = T, p_boot = p_raw, p_holm = p_holm,
p_single_step = p_single)
list(test = rows, contrasts = contrasts)
}
.rihc_failure <- function(hypothesis, message) {
data.frame(hypothesis = hypothesis,
procedure = c("Jackknife_wild_Wald", "Jackknife_wild_max", "Jackknife_wild_Holm"),
statistic = NA_real_, df = NA_integer_, p_value = NA_real_, reject = NA,
p_chisq = NA_real_, bootstrap_q95 = NA_real_,
n_invalid_bootstrap = NA_integer_, status = "failed", error = message)
}
.rihc_subject_influence <- function(X, y, left, right, group,
correction = c("HC2_type", "HC3_type", "none")) {
correction <- match.arg(correction)
beta <- .rihc_fit(X, y)
mu <- plogis(drop(X %*% beta))
w <- mu * (1 - mu)
scores <- X * (y - mu)
F <- crossprod(X * sqrt(w))
R <- chol(F)
Rinv <- backsolve(R, diag(ncol(X)))
N <- length(group)
D <- matrix(0, N, ncol(X), dimnames = list(seq_len(N), colnames(X)))
max_leverage <- numeric(N)
a <- switch(correction, none = 0, HC2_type = .5, HC3_type = 1)
for (i in seq_len(N)) {
# Logical OR includes within-subject rows once and cross-subject rows
# in BOTH participating subjects' blocks.
rows <- left == i | right == i
Gi <- colSums(scores[rows, , drop = FALSE])
Fi <- crossprod(X[rows, , drop = FALSE] * sqrt(w[rows]))
K <- crossprod(Rinv, Fi %*% Rinv)
K <- (K + t(K)) / 2
ev <- eigen(K, symmetric = TRUE)
lambda <- ev$values
if (min(lambda) < -1e-8 || max(lambda) > 1 + 1e-8)
stop("Subject leverage eigenvalues outside [0,1].")
lambda <- pmax(lambda, 0)
max_leverage[i] <- max(lambda)
if (a > 0 && max(lambda) >= 1 - 1e-8)
stop("Subject leverage too close to one for correction.")
z <- drop(forwardsolve(t(R), Gi))
if (a > 0) {
z <- drop(ev$vectors %*% (
(1 - lambda)^(-a) * drop(crossprod(ev$vectors, z))))
}
# Equivalent to F^-1 * (I - Fi F^-1)^(-a) * Gi.
D[i, ] <- drop(backsolve(R, z))
}
# Correct first, then center within arms. Each subject keeps one vector
# spanning all coefficients and all visits.
for (ii in split(seq_len(N), group)) {
D[ii, ] <- sweep(D[ii, , drop = FALSE], 2L,
colMeans(D[ii, , drop = FALSE]), "-")
}
# No extra ng/(ng-1) scaling: the correction is already in D.
# Both original covariance and bootstrap perturbation covariance = D'D.
list(beta = beta, D = D, V = crossprod(D), group = group,
factors = rep(1, N), max_subject_leverage = max_leverage,
correction = correction)
}
.rihc_fixed_test <- function(jk, L, Xi, hypothesis, alpha) {
qrL <- qr(t(L), tol = 1e-10)
q <- qrL$rank
selected <- qrL$pivot[seq_len(q)]
H <- jk$D %*% t(L)
H0 <- H[, selected, drop = FALSE]
theta <- drop(L %*% jk$beta)
V0 <- crossprod(H0)
ch <- .rihc_chol(V0)
se <- sqrt(colSums(H^2))
if (any(!is.finite(se)) || any(se <= 0)) stop("Invalid contrast SE.")
Q <- sum(forwardsolve(t(ch), theta[selected])^2)
T <- theta / se
M <- max(abs(T))
delta <- t(Xi) %*% H
Qstar <- colSums(forwardsolve(t(ch), t(delta[, selected, drop = FALSE]))^2)
Tstar <- sweep(delta, 2L, se, "/")
Mstar <- apply(abs(Tstar), 1L, max)
B <- ncol(Xi)
tailp <- function(z, t) (1 + sum(z >= t)) / (B + 1)
raw <- vapply(seq_along(T), function(j) tailp(abs(Tstar[, j]), abs(T[j])), 0.0)
holm <- p.adjust(raw, "holm")
single <- vapply(abs(T), function(t) tailp(Mstar, t), 0.0)
p <- c(tailp(Qstar, Q), tailp(Mstar, M), min(holm))
list(test = data.frame(hypothesis = hypothesis,
procedure = c("Jackknife_wild_Wald", "Jackknife_wild_max", "Jackknife_wild_Holm"),
statistic = c(Q, M, M), df = q, p_value = p, reject = p <= alpha,
p_chisq = c(pchisq(Q, q, lower.tail = FALSE), NA_real_, NA_real_),
bootstrap_q95 = c(unname(quantile(Qstar, .95)), unname(quantile(Mstar, .95)), NA_real_),
n_invalid_bootstrap = 0L, status = "ok", error = NA_character_),
contrasts = data.frame(contrast = rownames(L), estimate = theta, SE = se,
statistic = T, p_boot = raw, p_holm = holm, p_single_step = single))
}
ri_hc_default_config <- function() {
list(times = 1:4, intercept = 0,
time_effect = sqrt(2) * .1, treatment_effect = sqrt(2) * .1,
time_treatment_interaction = 0,
sigma_intercept = 1.5, sigma_error = 1, seed = 20261008L)
}
.rihc_generate <- function(N, cfg) {
# Matches generate_gaussian() in Simulation_Gaussian_RI_clean.R:
# intercepts drawn first, then errors in subject-then-visit order.
J <- length(cfg$times)
group <- rep(0:1, each = N / 2)
random_intercept <- rnorm(N, sd = cfg$sigma_intercept)
time <- rep(cfg$times, N)
treatment <- rep(group, each = J)
outcome <- cfg$intercept + cfg$time_effect * time +
cfg$treatment_effect * treatment +
cfg$time_treatment_interaction * time * treatment +
rep(random_intercept, each = J) + rnorm(N * J, sd = cfg$sigma_error)
matrix(outcome, nrow = N, ncol = J, byrow = TRUE)
}
.rihc_truth <- function(cfg) {
times <- cfg$times
J <- length(times)
vp <- t(combn(seq_len(J), 2L))
gap <- times[vp[, 2L]] - times[vp[, 1L]]
slopes <- vapply(0:1, function(a) {
lambda <- cfg$time_effect + a * cfg$time_treatment_interaction
target <- pnorm(lambda * gap / (sqrt(2) * cfg$sigma_error))
fun <- function(b) sum(gap * (target - plogis(b * gap)))
bound <- 1
while (fun(-bound) < 0 || fun(bound) > 0) {
bound <- 2 * bound
if (bound > 1e6) stop("Cannot bracket temporal working target.")
}
uniroot(fun, c(-bound, bound), tol = 1e-12)$root
}, numeric(1))
PI <- pnorm((cfg$treatment_effect + cfg$time_treatment_interaction * times) /
sqrt(2 * (cfg$sigma_intercept^2 + cfg$sigma_error^2)))
if (any(PI <= 0 | PI >= 1)) stop("Treatment PI numerically on boundary.")
setNames(c(slopes[2L], slopes[1L], qlogis(PI)),
c("trend_treat", "trend_ctrl", paste0("trt_visit", seq_len(J))))
}
run_Gaussian_RI_HC_wild <- function(
cfg = ri_hc_default_config(),
sample_sizes = c(16, 20, 30, 60), n_sim = 1000L, B = 999L,
correction = c("HC3_type", "HC2_type", "none"),
studentizer = c("fixed", "draw_specific"),
weights = c("rademacher", "mammen"), alpha = .05,
bootstrap_seed = 271828L, progress_every = 25L,
store_details = TRUE) {
correction <- match.arg(correction)
studentizer <- match.arg(studentizer)
weights <- match.arg(weights)
required <- names(ri_hc_default_config())
if (!all(required %in% names(cfg))) stop("cfg lacks required RI parameters.")
stopifnot(length(cfg$times) >= 2L, all(is.finite(cfg$times)),
all(diff(cfg$times) > 0), cfg$sigma_intercept >= 0, cfg$sigma_error > 0,
all(is.finite(unlist(cfg[required]))), length(sample_sizes) >= 1L,
all(is.finite(sample_sizes)), all(sample_sizes >= 6L),
all(sample_sizes %% 2L == 0L), length(n_sim) == 1L, n_sim >= 1L,
is.finite(n_sim), n_sim %% 1L == 0L, length(B) == 1L, is.finite(B),
B >= 99L, B %% 1L == 0L, alpha > 0, alpha < 1,
progress_every >= 1L, cfg$seed > 0,
cfg$seed + max(sample_sizes) * 100000 + n_sim < .Machine$integer.max,
bootstrap_seed > 0, bootstrap_seed + n_sim < .Machine$integer.max)
J <- length(cfg$times)
truth <- .rihc_truth(cfg)
Ltime <- matrix(c(1, -1, rep(0, J)), 1L,
dimnames = list("treated_minus_control_time", names(truth)))
Ltrt <- cbind(matrix(0, J, 2L), diag(J) - matrix(1 / J, J, J))
dimnames(Ltrt) <- list(paste0("visit", seq_len(J), "_minus_mean"), names(truth))
Ls <- list(time = Ltime, treatment = Ltrt)
null_holds <- vapply(Ls, function(L) max(abs(L %*% truth)) < 1e-10, TRUE)
results <- vector("list", length(sample_sizes) * n_sim * 2L)
details <- if (store_details) vector("list", length(sample_sizes) * n_sim) else NULL
k <- job <- 0L
for (N in sample_sizes) {
N <- as.integer(N)
design <- .rihc_design(N, J)
# Use ACTUAL visit-time gaps rather than assuming visits are equally spaced.
within <- design$left == design$right
il <- design$left_index[within, 2L]
ir <- design$right_index[within, 2L]
ratio <- (cfg$times[ir] - cfg$times[il]) / (ir - il)
design$X[within, 1:2] <- design$X[within, 1:2, drop = FALSE] * ratio
message("RI: N total = ", N, "; correction = ", correction,
"; studentizer = ", studentizer)
for (run in seq_len(n_sim)) {
job <- job + 1L
warnings_run <- character()
capture_warning <- function(w) {
warnings_run <<- c(warnings_run, conditionMessage(w))
invokeRestart("muffleWarning")
}
# Exact data-seed convention of the original RI script.
data_seed <- as.integer(cfg$seed + N * 100000 + run)
set.seed(data_seed)
Y <- .rihc_generate(N, cfg)
yl <- Y[design$left_index]; yr <- Y[design$right_index]
y <- as.numeric(yr > yl) + .5 * as.numeric(yr == yl)
fit <- tryCatch(withCallingHandlers({
if (any(y == .5)) stop("Unexpected ties in unrounded Gaussian RI outcomes.")
.rihc_subject_influence(design$X, y, design$left, design$right,
design$group, correction)
}, warning = capture_warning), error = function(e) e)
set.seed(as.integer(bootstrap_seed + run))
Xi <- matrix(.rihc_weights(N * B, weights), nrow = N, ncol = B)
for (hyp in names(Ls)) {
ans <- if (inherits(fit, "error")) fit else
tryCatch(withCallingHandlers({
test_fn <- if (studentizer == "fixed") .rihc_fixed_test else .rihc_test
test_fn(fit, Ls[[hyp]], Xi, hyp, alpha)
}, warning = capture_warning), error = function(e) e)
test <- if (inherits(ans, "error")) .rihc_failure(hyp, conditionMessage(ans)) else ans$test
test$warning <- paste(unique(warnings_run), collapse = " | ")
test$null_holds <- null_holds[[hyp]]
test$quantity <- if (null_holds[[hyp]]) "null_rejection_rate" else "power"
k <- k + 1L
results[[k]] <- cbind(data.frame(N = N, run = run, data_seed = data_seed,
model = paste("RI", correction, studentizer, sep = "_")), test)
}
if (store_details) {
details[[job]] <- if (inherits(fit, "error")) {
list(N = N, run = run, data_seed = data_seed, error = conditionMessage(fit))
} else {
list(N = N, run = run, data_seed = data_seed, beta = fit$beta,
V = fit$V, max_subject_leverage = fit$max_subject_leverage)
}
}
if (run == 1L || run %% progress_every == 0L || run == n_sim)
message("  N = ", N, ": ", run, "/", n_sim)
}
}
runs <- do.call(rbind, results)
rownames(runs) <- NULL
label <- paste("Subject", correction, studentizer, sep = "_")
runs$procedure <- sub("^Jackknife_wild", label, runs$procedure)
runs$valid <- runs$status == "ok" & is.finite(runs$p_value)
keys <- interaction(runs$N, runs$hypothesis, runs$procedure, drop = TRUE)
summary <- do.call(rbind, lapply(split(runs, keys), function(z) {
nv <- sum(z$valid); nr <- sum(z$reject[z$valid], na.rm = TRUE)
rate <- if (nv > 0L) nr / nv else NA_real_
cbind(z[1L, c("N", "model", "hypothesis", "procedure", "quantity"), drop = FALSE],
data.frame(n_total = nrow(z), n_valid = nv, n_failed = nrow(z) - nv,
n_with_warnings = sum(nzchar(z$warning)), n_rejected = nr,
failure_rate = 1 - nv / nrow(z), rejection_rate = rate,
MCSE = sqrt(rate * (1 - rate) / max(nv, 1L))))
}))
summary <- summary[order(summary$N, summary$hypothesis, summary$procedure), ]
rownames(summary) <- NULL
list(runs = runs, summary = summary,
failures = runs[!runs$valid, c("N", "run", "hypothesis", "procedure", "error", "warning")],
fits = details, truth = truth,
settings = list(cfg = cfg, N_is_total = TRUE, sample_sizes = sample_sizes,
n_sim = n_sim, B = B, correction = correction, studentizer = studentizer,
weights = weights, alpha = alpha, bootstrap_seed = bootstrap_seed,
method_status = "Experimental overlapping-subject KC/MD wild bootstrap",
generator = "Original Gaussian RI: no random slope, unrounded outcomes"))
}
