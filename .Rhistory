print(res_with3)
res_with1 <- VarSelCluster(x, gvals = 1, nbcores = 4, crit.varsel = "BIC")
print(res_with1)
res_with2 <- VarSelCluster(x, gvals = 2, nbcores = 4, crit.varsel = "BIC")
print(res_with2)
res_with3 <- VarSelCluster(x, gvals = 3, nbcores = 4, crit.varsel = "BIC")
print(res_with3)
res_without <- VarSelCluster(x, gvals = 1:3, vbleSelec = FALSE, crit.varsel = "BIC")
# Cluster analysis with variable selection (with parallelisation)
res_with <- VarSelCluster(x, gvals = 1:3, nbcores = 4, crit.varsel = "BIC")
print(res_with)
# Cluster analysis with variable selection (with parallelisation)
