
library(dplyr)
library(aod)
library(geessbin)
source("functions.R")
source("lwo.R")
library(pim)
library(tidyverse)
library(aod)
library(multcomp)
library(mvtnorm)
library(nparLD)

visits <- c(0,4,8,12,16) # baseline is visit = 0 
#--- Derived from SID trial
# base ordinal category probabilities if all covariates are zero
baseprobs <- rev(c(0.06,0.11,0.12,0.50,0.21)) # reversed so larger outcomes are better
# covariate effects 
covs_effects_baseline <- c("trt"=0,"age"=-0.005,"pre_diarrhea"= 0.23)
#--- Derived from SID trial
# correlation structure and correlation coefficient 
corstr <- "ar1"
rho <- 0.6
corMatrix <- generate_corMatrix(n_visits = length(visits),rho=rho,corstr = corstr)
# simulation scenario, one of null, SID, pos and con
scenario <- "pos"
time_effect <- switch(scenario,
                      "null" = 0.15,
                      "SID" = 0.15,
                      "pos" = 0.15,
                      "con" = 0
) # beta1, positive time trend towards higher score (self-healing)
trt_effect <- switch(scenario,
                     "null" = 0,
                     "SID" = 0,
                     "pos" = 0.2,
                     "con" = 1
)
time_trt_interaction <- switch(scenario,
                               "null" = 0,
                               "SID" = -0.02,# -0.02 comes from SID trial (after week 1) which is very neutral
                               "pos" = 0,
                               "con" = 0
)


# working correlation used for modeling
corstr_working <- "independence"



N=20000

for(N in c(16,18,20,24,26,30,40,50,60)){

 nparLD_pvalues_W = c()
 nparLD_pvalues_A = c()
 
  for(sims in 1:nr_of_iters){
    if(sims%%100==0){cat("Iteration: ",sims,"\n")}
    l = sims
    set.seed(sims)
    dat <- gen_data(N,baseprobs,covs_effects_baseline,
                    time_effect,trt_effect,time_trt_interaction,
                    visits,corMatrix)
    dat_wide <- dat$wide_format
    dat_long <- dat$long_format
    ggplot(data=dat$long_format,aes(x=time,y=GBS_DS,group=id,color=as.factor(trt)))+geom_line()+ stat_summary(aes(group=as.factor(trt),linetype=as.factor(trt)), fun.y=mean, geom="line", colour="green")
    # create indicator for week 4 and week 8
    dat_long <- dat_long |>
      mutate(w4 = 1*(time==4),w8 = 1*(time==8),w12 = 1*(time==12),w16 = 1*(time==16))
    
    ## We drop the baseline visit since the wind odds is by definition equal there, changes are expected between visit 0 and followup visits
    

    mod_nparlD <- nparLD(GBS_DS ~ visit_cat * trt, data = dat_long%>%filter(time!=0),
                        subject = "id", description = FALSE)
    
    nparLD_pvalues_W = c(nparLD_pvalues_W,mod_nparlD$Wald.test[3,3])
    nparLD_pvalues_A = c(nparLD_pvalues_A ,mod_nparlD$ANOVA.test[3,3])
    
    }  
  
  
  
  save.image(paste0("small_sample_type1_NPARLD_",N,"_POmodel.Rdata"))
}

load(paste0("small_sample_type1_NPARLD_",16,"_POmodel.Rdata"))
mean(nparLD_pvalues_W<=0.05)
mean(nparLD_pvalues_A<=0.05)


